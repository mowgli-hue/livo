# Copy to .env and fill in. The server runs WITHOUT any of these (mock mode);
# add keys to switch each provider from mock -> live.

PORT=8787

# --- AI engine (optional). Without it, a deterministic rule-based planner is used. ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# --- Provider mode: "mock" (default) or "live" per provider ---
PROVIDER_MAPS=mock        # live -> Google Places / Apple MapKit
PROVIDER_STAYS=mock       # live -> Airbnb / Booking / hotel APIs
PROVIDER_EVENTS=mock      # live -> Ticketmaster / Eventbrite / city feeds
PROVIDER_SOCIAL=mock      # live -> Foursquare Places (richer hidden-gem discovery)

# Auth / sync
JWT_SECRET=               # any long random string (sign-in tokens)
FOURSQUARE_API_KEY=       # foursquare.com/developers (free) — for PROVIDER_SOCIAL=live

# --- Live provider keys (only needed when PROVIDER_* = live) ---
GOOGLE_PLACES_API_KEY=
AIRBNB_PARTNER_KEY=
TICKETMASTER_API_KEY=
EVENTBRITE_TOKEN=
INSTAGRAM_GRAPH_TOKEN=

# --- Database (optional). Without it, an in-memory store is used. ---
DATABASE_URL=             # e.g. postgres://user:pass@localhost:5432/localescape
